; Each explicit selection reruns external work even when Dune inputs are unchanged.
; All real actions share one workspace lock. The aggregate is one serial runner,
; deliberately not a fan-out of endpoint aliases.
(rule
 (alias real-elaboration)
 (deps (universe) (sandbox none) (alias real-inputs) resolve.py configure.py)
 (locks real-eda)
 (action
  (run python3 -B %{dep:runner.py} --endpoint elaboration
   --config %{env:HARDCAML_WORKBENCH_REAL_TEST_CONFIG=}
   --daemon %{exe:../../../daemon/main.exe}
   --client %{exe:../../../terminal/main.exe})))

