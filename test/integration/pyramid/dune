; Resolution helpers are stdlib-only and never install or launch tools. Production
; executable closures are tracked by the exe dependencies on each real action.
(rule
 (alias real-preflight)
 (deps (universe) (sandbox always) (alias real-inputs) resolve.py configure.py)
 (action
  (run python3 -B %{dep:runner.py} --preflight-only
   --config %{env:HARDCAML_WORKBENCH_REAL_TEST_CONFIG=})))

(alias
 (name real-inputs)
 (deps runner.py resolve.py configure.py))

(rule
 (alias runtest)
 (deps (sandbox always) test_runner.py runner.py resolve.py configure.py configure_private.py dune ../../../dune ../../dune)
 (action
  (progn
   (run timeout 30s python3 -B %{dep:test_runner.py} -v)
   (run timeout 30s python3 -B %{dep:runner.py} --self-test))))
