; runner.py is stdlib-only: no undeclared fixture or script imports. Production
; executable closures are tracked by the exe dependencies on each real action.
(alias
 (name real-inputs)
 (deps runner.py))

(rule
 (alias runtest)
 (deps (sandbox always) test_runner.py runner.py configure.py dune ../../../dune ../../dune)
 (action
  (progn
   (run timeout 30s python3 -B %{dep:test_runner.py} -v)
   (run timeout 30s python3 -B %{dep:runner.py} --self-test))))
